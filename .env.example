# --- Database (MongoDB Atlas — free M0) ---
# Create a cluster at https://www.mongodb.com/atlas and paste the connection string.
# Works for both local dev and Vercel. Include the database name in the path.
DATABASE_URL="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/macros?retryWrites=true&w=majority"

# --- Meal photo -> macros (pick ONE) ---
# Powers the macro estimator, which is how every meal gets logged — one of
# these is required.
#
# Option A — Vercel AI Gateway. Billed to AI Gateway Credits on your Vercel
# team, which gets a monthly included credit (the team needs a payment method
# on file to unlock it). Create a key in the Vercel dashboard under AI Gateway.
# Takes precedence over ANTHROPIC_API_KEY when both are set.
AI_GATEWAY_API_KEY=""

# Option B — Anthropic directly. https://console.anthropic.com/
ANTHROPIC_API_KEY=""

# Optional model override. Defaults to Claude Opus 5, which is NOT available on
# the AI Gateway free tier — every Anthropic model there returns 403
# RestrictedModelsError, including the "Fast" variants. Free-tier credits
# ($5/30 days) are only spendable on free-tier-eligible models, so a free-tier
# team MUST set one here or the estimator fails on every request.
#
# Mean calorie error vs. published values, 6 text cases x 3 runs:
#   openai/gpt-4.1-nano           14% / 16% / 16%  ~2s   <- recommended
#   google/gemini-2.5-flash-lite  37% / 31% / 11%  ~15s  accurate but erratic
#   amazon/nova-lite              43%                    drops whole foods
#   openai/gpt-5-nano             unreliable — frequently times out
#   alibaba/qwen3.7-flash         accurate but very slow
#
# gpt-4.1-nano is chosen for consistency, not peak accuracy: flash-lite's best
# runs beat it, but its spread is 8-37% on identical inputs. Every estimate is
# reviewed and edited before saving, so predictable beats occasionally-brilliant.
# Caveat: measured on text descriptions only. Photo estimation is a harder task
# and the ranking may differ.
#
# Free-tier requests are also rate limited. A throttled call retries with
# backoff and can take ~60s instead of ~2s.
NUTRITION_MODEL=""

# --- Password gate ---
# Gates the whole app (it shows what you ate). Leave empty to disable auth
# (e.g. local-only). Required before deploying publicly.
DASHBOARD_PASSWORD=""

# --- Timezone fallback (optional) ---
# IANA timezone used to bucket meals into days until a timezone is saved in
# Settings. Defaults to America/New_York.
# APP_TZ="America/Los_Angeles"
